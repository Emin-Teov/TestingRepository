APP_NAME="Warehouse"
APP_ENV=local
APP_DEBUG=true
# Leave empty to detect automatically (works in a sub-folder such as http://localhost/Framework).
APP_URL=
APP_TIMEZONE=Asia/Baku
APP_LOCALE=az
# Shown next to prices and stock values.
APP_CURRENCY=AZN

# MySQL / MariaDB (XAMPP, shared hosting). Session.sql creates this database with sample data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=warehouse
DB_USERNAME=root
DB_PASSWORD=

# sqlite needs no server: the file is created in storage/database on first use.
# DB_CONNECTION=sqlite
# DB_DATABASE=storage/database/database.sqlite

SESSION_NAME=warehouse_session

# Used by `php console db:seed` to create the first administrator.
# Leave the password empty to generate a random one (printed once).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
