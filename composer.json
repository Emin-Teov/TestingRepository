{
    "name": "emin-teov/framework",
    "description": "A small PHP 8.2+ MVC framework with an admin dashboard, database migrations, a CLI console and a JSON API.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Framework\\": "framework/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "framework/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "@php console serve"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
